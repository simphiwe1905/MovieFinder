<?xml version="1.0" encoding="utf-8"?>

<!-- Main layout for the MovieFinder home screen -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Settings button -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙ SETTINGS"
        android:textSize="16sp"
        android:layout_margin="12dp" />

    <Button
        android:id="@+id/btnFavourites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❤️ FAVOURITES"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnWatchlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔖 WATCHLIST"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnGenres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎬 GENRES"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Search box -->
    <EditText
        android:id="@+id/edtSearchMovie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:hint="Search for a movie..."
        android:inputType="text"
        android:singleLine="true" />

    <!-- Search button -->
    <Button
        android:id="@+id/btnSearchMovie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:text="🔎 SEARCH" />

    <!-- RecyclerView for listing movies -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/movieRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
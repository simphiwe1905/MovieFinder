<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cinewatcher_backround">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Movie poster -->

        <ImageView
            android:id="@+id/detailMoviePoster"
            android:layout_width="220dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="Movie poster"
            android:layout_marginTop="10dp" />


        <!-- Movie title -->

        <TextView
            android:id="@+id/detailMovieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Movie Title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- Rating -->

        <TextView
            android:id="@+id/detailMovieRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⭐ 8.5"
            android:textColor="#42A5F5"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- Release date -->

        <TextView
            android:id="@+id/detailMovieReleaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📅 Release Date"
            android:textColor="#8FA8C4"
            android:textSize="15sp" />


        <!-- Overview heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Overview"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- Overview -->

        <TextView
            android:id="@+id/detailMovieOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Movie overview"
            android:textColor="#A9BCD0"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />


        <!-- Favourite -->

        <Button
            android:id="@+id/btnFavourite"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="❤️ ADD TO FAVOURITES"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#1976D2" />


        <!-- Watchlist -->

        <Button
            android:id="@+id/btnWatchlist"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="🔖 ADD TO WATCHLIST"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#12365B" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/another_backround"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!--Logo-->

        <ImageView
            android:id="@+id/cinewatchLogo"
            android:layout_width="150dp"
            android:layout_height="112dp"
            android:src="@drawable/cinewatch_logo"
            android:layout_marginHorizontal="100dp"
            android:scaleType="fitCenter"
            android:contentDescription="CINEWATCH Logo" />

        <!-- App Logo / Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CINEWATCHER🎥"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="60dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your movie world starts here"
            android:textColor="#8FA8C4"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="50dp" />


        <!-- Login heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in to continue exploring movies."
            android:textColor="#8FA8C4"
            android:textSize="14sp"
            android:layout_marginBottom="25dp" />


        <!-- Email -->

        <EditText
            android:id="@+id/edtLoginEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email address"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890A8"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:backgroundTint="#1B4F80"
            android:layout_marginBottom="15dp" />


        <!-- Password -->

        <EditText
            android:id="@+id/edtLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Password"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890A8"
            android:textSize="15sp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:backgroundTint="#1B4F80"
            android:layout_marginBottom="25dp" />


        <!-- Login button -->

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SIGN IN"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="15dp" />


        <!-- Register -->

        <Button
            android:id="@+id/btnGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#42A5F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#102B4A" />

    </LinearLayout>

</ScrollView>